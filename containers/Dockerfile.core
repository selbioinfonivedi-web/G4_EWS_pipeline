# g4watch/core — the Python package and its CLI.
# Runs Stage 0, Stage 1 QC, Stage 4/4.5 and the gated stages.
# Tag, not digest. Digest pinning is real reproducibility work and is done
# at build time by `make containers`, which resolves every base image to a
# digest and records it in containers/IMAGE_DIGESTS.tsv. Writing a digest
# here by hand would be a guess, and a wrong digest fails obscurely.
FROM python:3.12-slim-bookworm

LABEL org.opencontainers.image.title="g4watch-core" \
      org.opencontainers.image.description="G4-WATCH Python package and CLI" \
      org.opencontainers.image.vendor="ICAR-NIVEDI" \
      org.opencontainers.image.licenses="MIT"

# R + ape are required: ancestral-state reconstruction shells out to
# scripts/R/ancestral_state_reconstruction.R, and Stage 4 cannot run
# without it. Installed here rather than in a separate image because the
# call is in-process from the D.H1 stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
        r-base-core r-cran-ape \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/g4watch
COPY pyproject.toml README.md ./
COPY g4watch ./g4watch
COPY scripts ./scripts

RUN pip install --no-cache-dir .

# Non-root: Nextflow's docker profile runs with the host uid/gid.
RUN useradd --create-home --uid 1000 g4watch || true
USER 1000

ENTRYPOINT ["g4watch"]
CMD ["--help"]
