/*
 * G4-WATCH Nextflow configuration.
 *
 * Reproducibility rules encoded here rather than left to the operator:
 *   - every process is containerised under the `docker`/`singularity`
 *     profiles, with image tags pinned (never `:latest`);
 *   - `resume` is on so a re-run is idempotent;
 *   - a process that fails deterministically stops the run. Retrying a
 *     scientific step until it happens to pass is exactly the
 *     silent-fallback behaviour this project forbids. Scheduler kills
 *     (OOM, time limit) are the deliberate exception — those are
 *     infrastructure events, not results. See the `process` block.
 */

manifest {
    name            = 'G4-WATCH'
    author          = 'ICAR-NIVEDI'
    description     = 'G-quadruplex genomic early-warning framework for livestock viruses'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

params {
    help            = false

    // Resource ceiling — see the `process` block below. Laptop-sized by
    // default; raise for a real run.
    max_memory      = System.getenv('G4WATCH_MAX_MEMORY') ?: '6.GB'
    max_cpus        = System.getenv('G4WATCH_MAX_CPUS')   ?: '4'
    max_time        = System.getenv('G4WATCH_MAX_TIME')   ?: '48.h'

    // --- required ---
    pathogen        = null      // e.g. 'fmdv'; resolved against config/
    outdir          = 'results'

    // --- optional pre-computed inputs -------------------------------
    // The FMDV corpus already has an alignment and a rooted tree built
    // by Sprint 3/4. Passing them skips the corresponding stage instead
    // of silently rebuilding (and possibly changing) a published input.
    alignment       = null
    rooted_tree     = null
    atlas           = null
    reference       = null      // reference FASTA; required when aligning
    accession_list  = null      // required by -entry ACQUISITION
    dates           = null      // TreeTime dates CSV; required when building the tree

    // --- stage toggles ----------------------------------------------
    // Stage 1.5 has no toggle: recombination screening is mandatory for
    // every pathogen (Build Architecture Section 11).
    // --- Stage 5 options (mirror the CLI flags) ----------------------
    force_unchecked         = false   // run Stage 5 without the D.H1 gate
    include_ineligible_loci = false   // forces a non-authoritative result
    exclude_lineages        = null    // comma-separated; unioned with the config

    skip_qc            = false
    skip_alignment     = false
    skip_phylogenetics = false

    // --- tool parameters (overridden by the pathogen YAML where both
    //     define a value; these are the resource-level defaults) ------
    mafft_args      = '--auto'
    iqtree_model    = 'GTR+F+I+G4'
    iqtree_bootstrap = 1000
    seed            = 20250823

    // --- executor (slurm / awsbatch profiles) ---
    queue           = null          // required by -profile slurm and awsbatch
    aws_region      = 'me-central-1'
    aws_cli_path    = '/home/ec2-user/miniconda/bin/aws'

    // --- reporting ---
    tracedir        = "${params.outdir}/pipeline_info"
}

// Deterministic by default: a fixed seed is part of the run's identity.
env {
    PYTHONHASHSEED = '0'
}

/*
 * Resource ceiling.
 *
 * The per-process requests below are what each stage *wants*;
 * `resourceLimits` caps them to what the host actually has, so the same
 * workflow runs on a laptop and on a cluster node without editing.
 * Without a cap, a request larger than physical memory is an immediate
 * hard failure rather than a slower run.
 *
 * Defaults are deliberately laptop-sized. Raise them for a real run —
 * either on the command line (--max_memory '64.GB') or via the
 * G4WATCH_MAX_* environment variables, which is the convenient form
 * inside a scheduler job script:
 *
 *     export G4WATCH_MAX_MEMORY='64.GB'
 *     export G4WATCH_MAX_CPUS=16
 */
process {
    // EVERY g4watch process pipes into `tee` so its log is both captured
    // and streamed. Without pipefail the pipeline's exit status is tee's,
    // which is 0 whatever happened upstream -- so a process whose tool was
    // missing, whose config was malformed, or which raised a Python
    // traceback reported COMPLETED with exit 0.
    //
    // This was not hypothetical. RECOMBINATION_SCREEN -- the screen the
    // architecture calls mandatory and gives no skip flag -- reported
    // COMPLETED after `g4watch: command not found`. It was caught only
    // because BUILD_DATES, later in the same run, declares an output file
    // that then did not exist; a process whose outputs happen to be
    // optional would have passed silently and every stage downstream would
    // have been told the screen had run.
    //
    // -e   stop at the first failing command
    // -u   an unset variable is an error, not an empty string
    // -o pipefail  a pipeline fails if ANY stage fails, not just the last
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Retry policy. The distinction that matters: a step killed by the
    // scheduler is an INFRASTRUCTURE event, not a scientific result, and
    // re-running it with more memory is not "retrying until it passes".
    // A step that fails deterministically must never be retried, so every
    // other exit code terminates the run.
    //
    //   104, 247      transient AWS Batch / container failures
    //   134           SIGABRT
    //   137           SIGKILL — cgroup OOM, the common Slurm memory kill
    //   139           SIGSEGV
    //   140, 143      SIGTERM — scheduler time-limit kill
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] && task.attempt <= 3
                      ? 'retry'
                      : 'terminate' }
    maxRetries    = 3
    cache         = 'lenient'

    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration
    ]

    // Requests escalate with each retry, so an OOM-killed task comes back
    // with more memory instead of failing identically. `resourceLimits`
    // above caps the escalation, so attempt 3 can never exceed the host.
    cpus   = { 1    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    withLabel: 'big_mem'   { memory = { 16.GB * task.attempt } }
    withLabel: 'multicore' { cpus   = { 8     * task.attempt } }
    withLabel: 'long'      { time   = { 24.h  * task.attempt } }

    // Exit code 3 means "the D.H1 gate is closed" — a correct, expected
    // outcome, not a crash. Nextflow removed `validExitStatus` in 25.x, so
    // the gated processes absorb exactly that code in their own script and
    // publish the explanation as output; every other non-zero status is
    // re-raised (see modules/scoring.nf). `terminate` here overrides the
    // retry policy above: a gated process must never be retried, because
    // its failures are never infrastructure.
    withLabel: 'gated' { errorStrategy = 'terminate' }
}

profiles {
    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor         = 'slurm'
        process.queue            = params.queue
        // Submit-rate limiting matters on a shared cluster: a burst of
        // submissions gets a job array throttled or rejected outright.
        executor.queueSize       = 50
        executor.submitRateLimit = '10/1min'
        singularity.enabled      = true
        singularity.autoMounts   = true
    }

    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = params.queue
        aws.region        = params.aws_region
        aws.batch.cliPath = params.aws_cli_path
        // S3 work dir is required for awsbatch; set with -w s3://bucket/work
        docker.enabled    = true
    }

    docker {
        docker.enabled       = true
        // The launch directory is mounted because config/, data/ and the
        // pathogen YAML are reached by PATH, not staged as Nextflow inputs.
        // Without it a task sees only its own work directory and every
        // `--pathogen <path>` fails inside the container with no output at
        // all, because the file simply is not there.
        docker.runOptions    = "-u \$(id -u):\$(id -g) -v ${launchDir}:${launchDir}"
        singularity.enabled  = false
        process {
            withLabel: 'g4watch'       { container = 'g4watch/core:1.0.0' }
            withLabel: 'alignment'     { container = 'g4watch/alignment:1.0.0' }
            withLabel: 'phylogenetics' { container = 'g4watch/phylogenetics:1.0.0' }
            withLabel: 'selection'     { container = 'g4watch/selection:1.0.0' }
            // The mount above puts config/ and data/ at the SAME absolute
            // path inside the container -- but a task's own CWD is still
            // its Nextflow work/hash/ staging directory, not launchDir, so
            // g4watch/config.py's config_dir() fell through past its
            // packaged-beside-code rule (wrong: the image pip-installs a
            // built wheel, so the package lives in site-packages with no
            // config/ beside it -- that fallback already exists, see its
            // docstring) to its cwd-relative rule, which resolved against
            // the task dir and found nothing there either. Every g4watch
            // process that names a pathogen by string rather than an
            // explicit --atlas/--alignment path failed with "No config at
            // <work dir>/config/<pathogen>.yaml" -- CALL_VARIANTS was
            // caught by an end-to-end run; RECOMBINATION_SCREEN and DH1_GATE
            // use the identical resolution and would have failed the same
            // way the moment they ran. Setting the explicit override here
            // (config_dir()'s first, highest-priority rule) is the fix the
            // module's own docstring says a deployment should use, rather
            // than depending on a CWD coincidence that a bind mount does
            // not create.
        }
        env.G4WATCH_CONFIG_DIR = "${launchDir}/config"
        // Same class of bug, a second module: recombination_screen.py's
        // default Phi binary path is ALSO computed from its own __file__,
        // which lands under site-packages inside any of these images and
        // nowhere near vendor/phipack/Phi. Pointed at the binary
        // containers/Dockerfile.selection builds and installs to this
        // exact path -- not at the host's bind-mounted vendor/phipack/Phi,
        // which would depend on that binary being built for a compatible
        // architecture and glibc, an assumption this deployment should not
        // have to make.
        env.G4WATCH_PHI_BINARY = "/usr/local/bin/Phi"
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process {
            withLabel: 'g4watch'       { container = 'g4watch/core:1.0.0' }
            withLabel: 'alignment'     { container = 'g4watch/alignment:1.0.0' }
            withLabel: 'phylogenetics' { container = 'g4watch/phylogenetics:1.0.0' }
            withLabel: 'selection'     { container = 'g4watch/selection:1.0.0' }
        }
        // Same fix as the docker profile above, and the same reason:
        // singularity.autoMounts puts the repository at the same absolute
        // path inside the container, but does not change a task's CWD away
        // from its own work/hash/ directory.
        env.G4WATCH_CONFIG_DIR = "${launchDir}/config"
        env.G4WATCH_PHI_BINARY = "/usr/local/bin/Phi"
    }

    // Runs against whatever is on PATH. Use for development only — a
    // published result must come from a containerised profile.
    //
    // "Whatever is on PATH" did not include `g4watch`, and that is how this
    // profile is normally installed: `pip install -e .` into a virtualenv at
    // the repo root, whose bin/ is on PATH only while the venv is activated.
    // Nextflow tasks do not inherit an activation, so every g4watch process
    // died with "command not found" -- and, before pipefail was set on
    // process.shell above, died reporting success.
    //
    // The venv is found by its position in the repo, not by a path on any
    // one machine: G4WATCH_BIN overrides, else <repo>/.venv/bin when it
    // exists, else PATH is left exactly as the caller set it, which is what
    // a system-wide or conda install wants.
    conda_free {
        process.container = null
        docker.enabled    = false
        singularity.enabled = false

        env.PATH = {
            def override = System.getenv('G4WATCH_BIN')
            def venvBin  = new File("${projectDir}/../.venv/bin")
            def prefix   = override ?: (venvBin.isDirectory() ? venvBin.canonicalPath : null)
            prefix ? "${prefix}:${System.getenv('PATH')}" : System.getenv('PATH')
        }()
    }

    test {
        // No pathogen is named here. Hard-coding one made `-profile test`
        // exercise a single virus forever, which is the opposite of what a
        // smoke profile is for. Pass --pathogen explicitly.
        params.outdir   = 'results_test'
    }
}

timeline { enabled = true; file = "${params.tracedir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/dag.svg";       overwrite = true }
