# g4watch/phylogenetics — IQ-TREE2, TreeTime, R+ape.
FROM python:3.12-slim-bookworm

LABEL org.opencontainers.image.title="g4watch-phylogenetics" \
      org.opencontainers.image.licenses="MIT"

ARG IQTREE_VERSION=2.3.6
ARG TREETIME_VERSION=0.11.4

RUN apt-get update && apt-get install -y --no-install-recommends \
        procps \
        wget ca-certificates r-base-core r-cran-ape \
    && wget -q "https://github.com/iqtree/iqtree2/releases/download/v${IQTREE_VERSION}/iqtree-${IQTREE_VERSION}-Linux-intel.tar.gz" \
    && tar -xzf "iqtree-${IQTREE_VERSION}-Linux-intel.tar.gz" \
    && mv "iqtree-${IQTREE_VERSION}-Linux-intel/bin/iqtree2" /usr/local/bin/ \
    && rm -rf "iqtree-${IQTREE_VERSION}-Linux-intel"* \
    && apt-get purge -y wget && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "phylo-treetime==${TREETIME_VERSION}"

USER 1000
