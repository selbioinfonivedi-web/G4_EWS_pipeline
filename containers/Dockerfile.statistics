# g4watch/statistics — R statistical stack for power analysis and
# Bayesian prior-sensitivity work (Sections 10.3, 13.4).
FROM r-base:4.3.3

LABEL org.opencontainers.image.title="g4watch-statistics" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev libssl-dev libxml2-dev python3 python3-numpy python3-scipy \
    && rm -rf /var/lib/apt/lists/*

RUN R -e "install.packages(c('pwr','brms','ape','phytools'), repos='https://cloud.r-project.org')"

USER 1000
