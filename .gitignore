# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Nextflow ---
work/
.nextflow/
.nextflow.log*
results/
trace.txt
timeline.html
report.html
dag.svg

# --- Vendored third-party checkouts ---
# Both carry their own .git, so committing them would create unconfigured
# gitlinks. Their provenance is pinned in vendor/PINNED_VERSIONS.tsv, which
# is the actual reproducibility record; `make vendor` restores and builds
# PhiPack at its pinned commit. See docs/installation.md.
vendor/phipack/
# vendor/phipack-src/ IS committed — PhiPack has no package, no release
# tarball and no versioned artifact, and Stage 1.5 is mandatory for every
# pathogen, so a pinned clone is a single point of failure for the whole
# gate. Only its build products are ignored.
vendor/phipack-src/**/*.o
vendor/phipack-src/Phi
vendor/phipack-src/Profile
vendor/phipack-src/ppma_2_bmp
vendor/phipack-src/src/ppma_2_bmp/ppma_2_bmp
vendor/phipack-src/*.log
vendor/phipack-src/*.sites
vendor/phipack-src/*.list
# G4RNA Screener is kept as a local reference copy only -- it is Python 2
# with a pickled PyBrain classifier and is NOT run by the pipeline. See
# vendor/README.md and docs/revision_log.md R-01.
vendor/g4rna_screener/

# --- PhiPack scratch output written into the CWD ---
# PhiPack writes these next to wherever it is invoked; the pipeline
# captures the parsed result, so the raw droppings are not artifacts.
/Phi.log
/Phi.inf.list
/Phi.inf.sites
/Phi.poly.unambig.sites

# --- Large regenerable data artifacts ---
# Reproducibility here is "regenerate from the committed accession list",
# not "commit 116 MB of derived FASTA". Everything ignored below is
# rebuilt by `nextflow run workflow/main.nf`; the accession lists,
# metadata, QC reports, atlases and testing ledger that define the run
# ARE committed. See docs/installation.md.
# Corpus artifacts are derived data, regenerable from the accession list
# and the pipeline. The metadata table and the QC report are kept because
# they are small, they are what the Appendix C floor is evaluated on, and
# a reader needs them to check a published verdict.
#
# Matched as corpus* rather than corpus/ so a second corpus for the same
# pathogen is covered too. The original rules were keyed to the exact
# directory name, so data/reference_genomes/fmdv/corpus_2026/ — 105 MB of
# alignments, trees and variant tables — was not ignored at all.
data/reference_genomes/*/corpus*/*.fasta
data/reference_genomes/*/corpus*/*.gb
data/reference_genomes/*/corpus*/aligned/
data/reference_genomes/*/corpus*/phylogenetics/
data/reference_genomes/*/corpus*/variants/
data/reference_genomes/*/corpus*/recombination/
data/reference_genomes/*/corpus*/serotype_o/
!data/reference_genomes/*/corpus*/*_metadata.tsv
!data/reference_genomes/*/corpus*/qc_report.tsv

# Raw NCBI downloads staged before corpus assembly: an input to
# acquisition, not an output of it, and re-fetchable from the accessions.
fmdvmetadata/

# Session scratch from an interactive IQ-TREE run.
/iqtree_run.log

# Saved workstation sessions are per-user state, not project data.
projects/

# --- Office lock files ---
# LibreOffice writes these beside any open document; they are per-machine
# and meaningless in a checkout.
.~lock.*#

# --- Superseded / local-only working files ---
# Design history and personal working documents, kept on disk but not
# pushed. The four mockups were the exploration that produced the single
# consolidated workstation in web/workstation/; g4_redesign.html is the
# supplied reference the institute skin was built from. All three are
# inputs to a decision already made, not source.
web/mockups/
/g4_redesign.html
/data_retrival_format.odt
*.retired

# --- Editor / OS ---
.Rhistory
.RData
.vscode/
.DS_Store
*.swp
.idea/

# local demo study for container smoke runs
/.demo/

# commit message drafts, local only
/.commits/

# build_deck.py writes numbered scratch decks as it goes; only the final
# deck in deliverables/ is a deliverable.
deliverables/ppt_assets/_partial_*.pptx
# and the deck itself is published one level up, never here
deliverables/ppt_assets/*.pptx
results/stratified/
data/uploads/
data/analyses.sqlite3*
results/analyses/

# Corpus GenBank downloads: large, regenerable from the accession query
# recorded in each config, and the parsed metadata/FASTA are what the
# pipeline reads.
data/reference_genomes/*/corpus/*_complete_genomes.gb
data/synthetic/*.fasta
